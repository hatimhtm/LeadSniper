# ── Supabase (required — both dashboard and scraper) ─────────────────
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Scraper-only env (optional — also settable from the dashboard UI) ─
# Anything you leave blank here can be set later from
# /dashboard/settings inside the app, which writes to the `ms_settings`
# table. Putting them in .env is just the dev convenience path.

# Google Places API — you can supply up to 2 keys for failover / quota
GOOGLE_PLACES_API_KEY_1=
GOOGLE_PLACES_API_KEY_2=

# Gemini (used to draft personalised outreach for each scored lead)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Scraper tuning
SCRAPER_DELAY_MIN=2000
SCRAPER_DELAY_MAX=5000
SCRAPER_MAX_RESULTS=60

# Your identity — interpolated into every AI-drafted message
USER_NAME=
USER_TITLE=
USER_EMAIL=
USER_WEBSITE=
